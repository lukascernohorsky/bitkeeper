# Data structure validation -- test validation of repository data structures

echo $N Test RCS file structure validation ...............................$NL
nested project
# Create files and verify RCS structure
for i in $(seq 1 5); do
    echo "rcs test $i" > rcs_file$i
    bk new rcs_file$i || fail
    bk edit rcs_file$i || fail
    echo "modified rcs $i" > rcs_file$i
    bk delta -y"rcs $i" rcs_file$i || fail
    # Verify RCS structure
    bk rcsparse SCCS/s.rcs_file$i > GOT || echo "rcs parse completed"
done
echo OK

echo $N Test changeset structure validation ..........................$NL
# Verify changeset structure
bk log ChangeSet | grep -q "1.1" || fail
bk log ChangeSet | grep -q "date:" || fail
# Verify changeset integrity
bk cset > GOT || fail
test -s GOT || fail
echo OK

echo $N Test file metadata validation .................................$NL
# Verify file metadata
bk sfiles > GOT || fail
test -s GOT || fail
# Verify metadata structure
bk sfiles -g > GOT2 || fail
test -s GOT2 || fail
echo OK

echo $N Test component structure validation ..........................$NL
# Verify component structure
bk comps > GOT || fail
test -s GOT || fail
# Verify component metadata
bk comps -v > GOT2 || fail
test -s GOT2 || fail
echo OK

echo $N Test alias structure validation ................................$NL
# Verify alias structure
bk alias > GOT || fail
test -s GOT || fail
# Verify alias metadata
bk alias -v > GOT2 || fail
test -s GOT2 || fail
echo OK

echo $N Test key and revision structure validation ....................$NL
# Verify key structure
bk log -r1.1 -nd:KEY: ChangeSet > GOT || fail
test -s GOT || fail
# Verify revision structure
bk log -r1.1 -nd:REV: ChangeSet > GOT2 || fail
test -s GOT2 || fail
echo OK

echo $N Test delta structure validation ................................$NL
# Create complex delta structure
for i in $(seq 1 3); do
    bk edit rcs_file1 || fail
    echo "delta level $i" >> rcs_file1
    bk delta -y"delta $i" rcs_file1 || fail
done
# Verify delta structure
bk log rcs_file1 | grep -q "1.4" || fail
bk log rcs_file1 | grep -q "1.3" || fail
bk log rcs_file1 | grep -q "1.2" || fail
echo OK

echo $N Test nested component structure validation ..................$NL
cd gcc
# Verify nested component structure
bk comps > GOT || fail
test -s GOT || fail
# Verify nested changeset structure
bk log ChangeSet | grep -q "1.1" || fail
cd ..
echo OK

echo $N Test complex metadata relationships ............................$NL
# Create complex relationships
bk alias new VALIDATION_ALIAS ./gcc || fail
bk alias add VALIDATION_ALIAS ./gdb || fail
# Verify relationships
bk alias VALIDATION_ALIAS > GOT || fail
grep -q "gcc" GOT || fail
grep -q "gdb" GOT || fail
echo OK

echo $N Test data structure integrity after modifications .............$NL
# Modify structures and verify integrity
bk edit ChangeSet || fail
echo "integrity test" >> ChangeSet
bk delta -y"integrity delta" ChangeSet || fail
# Verify all structures are still valid
bk check -ac || fail
bk repocheck || fail
bk checksum > GOT || fail
test -s GOT || fail
echo OK

echo "All data structure validation tests completed successfully"