# root -- test root command functionality

echo $N Test root help and usage ...................................$NL
# Test help output
bk root --help > GOT 2>&1
# Should contain usage information
grep -q "usage:" GOT || fail -f GOT
grep -q "root" GOT || fail -f GOT
echo OK

echo $N Test root with invalid options .............................$NL
# Test invalid option
bk root -z 2> ERR && fail
# Should get bad argument error
grep -q "unknown option" ERR || fail -f ERR
echo OK

echo $N Test root command recognition ..............................$NL
# Test that root command is recognized
bk root --help > /dev/null 2>&1 || fail
echo OK

echo $N Test root in simple repository ..............................$NL
nested project
# Test root in simple repository
bk root > GOT || fail
# Should show the repository root
test -s GOT || fail
echo OK

echo $N Test root in nested repository ..............................$NL
cd gcc
# Test root in nested component
bk root > GOT || fail
# Should show the product root
test -s GOT || fail
cd ..
echo OK

echo $N Test root with standalone option ............................$NL
# Test standalone option
bk root -S > GOT || fail
# Should show the standalone root
test -s GOT || fail
echo OK

echo $N Test root with path argument ...............................$NL
# Test with path argument
bk root . > GOT || fail
# Should show the root for current directory
test -s GOT || fail
echo OK

echo $N Test root with file argument ................................$NL
# Test with file argument
bk root ChangeSet > GOT || fail
# Should show the root for the file
test -s GOT || fail
echo OK

echo "All root tests completed successfully"