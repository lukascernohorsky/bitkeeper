# Sync and conflict scenarios -- test synchronization and conflict resolution

echo $N Test basic synchronization simulation ..........................$NL
nested project
# Simulate synchronization by creating files that would need sync
for i in $(seq 1 3); do
    echo "sync file $i" > sync_file$i
    bk new sync_file$i || fail
    bk edit sync_file$i || fail
    echo "sync content $i" > sync_file$i
    bk delta -y"sync $i" sync_file$i || fail
done
# Verify repository is consistent after sync-like operations
bk check -ac || fail
echo OK

echo $N Test conflict detection scenarios .............................$NL
# Create potential conflict scenarios
bk edit sync_file1 || fail
bk edit sync_file2 || fail
# Both files are now "in progress" which could lead to conflicts
bk sfiles -g > GOT || fail
grep -q "sync_file1" GOT || fail
grep -q "sync_file2" GOT || fail
echo OK

echo $N Test merge-like operations .....................................$NL
# Simulate merge operations
cd gcc
bk edit ChangeSet || fail
echo "merge simulation" >> ChangeSet
bk delta -y"merge test" ChangeSet || fail
cd ..
# Verify repository handles merge-like changes
bk check -ac || fail
echo OK

echo $N Test component synchronization scenarios ....................$NL
# Test synchronization between components
cd gcc
# Make changes in one component
bk edit ChangeSet || fail
echo "component sync" >> ChangeSet
bk delta -y"component sync" ChangeSet || fail
cd ../gdb
# Make changes in another component
bk edit ChangeSet || fail
echo "another component sync" >> ChangeSet
bk delta -y"another component sync" ChangeSet || fail
cd ..
# Verify overall consistency
bk check -ac || fail
echo OK

echo $N Test conflict resolution simulation ..........................$NL
# Simulate conflict resolution
# Create files that might conflict
bk new conflict_file1 || fail
bk new conflict_file2 || fail
# Modify both files
bk edit conflict_file1 || fail
bk edit conflict_file2 || fail
echo "conflict content 1" > conflict_file1
echo "conflict content 2" > conflict_file2
bk delta -y"conflict 1" conflict_file1 || fail
bk delta -y"conflict 2" conflict_file2 || fail
# Verify repository handles potential conflicts
bk check -ac || fail
echo OK

echo $N Test synchronization with component changes ..................$NL
# Test sync scenarios with nested components
cd gcc
# Create files in component
for i in $(seq 1 2); do
    echo "component sync $i" > comp_sync$i
    bk new comp_sync$i || fail
    bk edit comp_sync$i || fail
    echo "component sync content $i" > comp_sync$i
    bk delta -y"comp sync $i" comp_sync$i || fail
done
cd ..
# Verify overall repository consistency
bk check -ac || fail
bk repocheck || fail
echo OK

echo $N Test complex synchronization workflow .........................$NL
# Create complex sync scenario
for i in $(seq 4 6); do
    echo "complex sync $i" > complex_sync$i
    bk new complex_sync$i || fail
    # Multiple modifications
    for j in $(seq 1 2); do
        bk edit complex_sync$i || fail
        echo "complex sync $i.$j" > complex_sync$i
        bk delta -y"complex $i.$j" complex_sync$i || fail
    done
done
# Verify repository handles complex sync
bk check -ac || fail
bk checksum > GOT || fail
test -s GOT || fail
echo OK

echo $N Test conflict scenario with file operations ..................$NL
# Test conflict scenarios with various file operations
bk cp sync_file1 copied_sync_file || fail
bk mv sync_file2 moved_sync_file || fail
# Verify repository handles file operation conflicts
bk check -ac || fail
echo OK

echo $N Test synchronization integrity verification ....................$NL
# Final verification of synchronization integrity
bk check -ac || fail
bk repocheck || fail
bk checksum > GOT || fail
test -s GOT || fail
# Verify all sync files are tracked
bk files | grep -q "sync_file" || fail
bk files | grep -q "complex_sync" || fail
echo OK

echo "All sync and conflict scenario tests completed successfully"