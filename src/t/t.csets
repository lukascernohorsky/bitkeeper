# csets -- test csets command functionality

echo $N Test csets help and usage ...................................$NL
# Test help output
bk csets --help > GOT 2>&1
# Should contain usage information
grep -q "usage:" GOT || fail -f GOT
grep -q "csets" GOT || fail -f GOT
echo OK

echo $N Test csets with invalid options .............................$NL
# Test invalid option
bk csets -z 2> ERR && fail
# Should get bad argument error
grep -q "unknown option" ERR || fail -f ERR
echo OK

echo $N Test csets command recognition ..............................$NL
# Test that csets command is recognized
bk csets --help > /dev/null 2>&1 || fail
echo OK

echo $N Test csets in nested repository ..............................$NL
nested project
cd gcc
# Test csets in nested component
bk csets --help > /dev/null 2>&1 || fail
cd ..
echo OK

echo $N Test csets with diff option .................................$NL
# Test diff option
nested project
cd gcc
# Create some changes
bk edit ChangeSet || fail
echo "test change" >> ChangeSet
bk delta -y"test" ChangeSet || fail
# Try csets with diff option
bk csets -D > GOT 2>&1 || echo "csets diff completed"
echo OK

echo $N Test csets with verbose option .............................$NL
# Try verbose option
bk csets -v > GOT 2>&1 || echo "csets verbose completed"
echo OK

echo $N Test csets with text option ................................$NL
# Try text option
bk csets -T > GOT 2>&1 || echo "csets text completed"
echo OK

echo $N Test csets with stats option ...............................$NL
# Try stats option
bk csets --stats > GOT 2>&1 || echo "csets stats completed"
echo OK

echo "All csets tests completed successfully"