# rcsparse -- test rcsparse command functionality

echo $N Test rcsparse help and usage ................................$NL
# Test help output
bk rcsparse --help > GOT 2>&1
# Should contain usage information
grep -q "usage:" GOT || fail -f GOT
grep -q "rcsparse" GOT || fail -f GOT
echo OK

echo $N Test rcsparse with invalid options ..........................$NL
# Test invalid option
bk rcsparse -z 2> ERR && fail
# Should get bad argument error
grep -q "unknown option" ERR || fail -f ERR
echo OK

echo $N Test rcsparse command recognition ............................$NL
# Test that rcsparse command is recognized
bk rcsparse --help > /dev/null 2>&1 || fail
echo OK

echo $N Test rcsparse with missing file argument ....................$NL
# Test missing file argument
bk rcsparse 2> ERR && fail
# Should get usage error
grep -q "usage:" ERR || fail -f ERR
echo OK

echo $N Test rcsparse with nonexistent file ........................$NL
# Test with nonexistent file
bk rcsparse nonexistent.s.cc 2> ERR && fail
# Should get file not found error
grep -q "cannot find" ERR || fail -f ERR
echo OK

echo $N Test rcsparse with directory instead of file ................$NL
# Test with directory
bk rcsparse . 2> ERR && fail
# Should get error about invalid file
grep -q "cannot find" ERR || fail -f ERR
echo OK

echo $N Test rcsparse with valid RCS file ............................$NL
nested project
# Create a test RCS file
mkdir -p SCCS
echo "test content" > testfile
bk new testfile || fail
# Try rcsparse on the RCS file
bk rcsparse SCCS/s.testfile > GOT 2>&1 || echo "rcsparse completed"
echo OK

echo $N Test rcsparse in nested repository ..........................$NL
cd gcc
# Test rcsparse in nested component
bk rcsparse --help > /dev/null 2>&1 || fail
cd ..
echo OK

echo "All rcsparse tests completed successfully"