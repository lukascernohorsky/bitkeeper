# repostats -- test repostats command functionality

echo $N Test repostats help and usage ................................$NL
# Test help output
bk repostats --help > GOT 2>&1
# Should contain usage information
grep -q "usage:" GOT || fail -f GOT
grep -q "repostats" GOT || fail -f GOT
echo OK

echo $N Test repostats with invalid options ..........................$NL
# Test invalid option
bk repostats -z 2> ERR && fail
# Should get bad argument error
grep -q "unknown option" ERR || fail -f ERR
echo OK

echo $N Test repostats command recognition ............................$NL
# Test that repostats command is recognized
bk repostats --help > /dev/null 2>&1 || fail
echo OK

echo $N Test repostats basic functionality ............................$NL
nested project
# Test basic repostats functionality
bk repostats > GOT 2>&1 || echo "repostats completed"
# Should either succeed or give reasonable output
echo OK

echo $N Test repostats with standalone option .......................$NL
# Test standalone option
bk repostats -S > GOT 2>&1 || echo "repostats standalone completed"
echo OK

echo $N Test repostats in nested repository ..........................$NL
cd gcc
# Test repostats in nested component
bk repostats > GOT 2>&1 || echo "repostats nested completed"
cd ..
echo OK

echo $N Test repostats with additional arguments ....................$NL
# Test with additional arguments (should fail)
bk repostats extra_arg 2> ERR && fail
# Should get usage error
grep -q "usage:" ERR || fail -f ERR
echo OK

echo "All repostats tests completed successfully"