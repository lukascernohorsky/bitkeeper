# set -- test set operations functionality

echo $N Test set help and usage ...................................$NL
# Test help output
bk set --help > GOT 2>&1
# Should contain usage information
grep -q "usage:" GOT || fail -f GOT
grep -q "set" GOT || fail -f GOT
echo OK

echo $N Test set with invalid options .............................$NL
# Test invalid option
bk set -z 2> ERR && fail
# Should get bad argument error
grep -q "unknown option" ERR || fail -f ERR
echo OK

echo $N Test set command recognition ..............................$NL
# Test that set command is recognized
bk set --help > /dev/null 2>&1 || fail
echo OK

echo $N Test set in nested repository ..............................$NL
nested project
cd gcc
# Test set in nested component
bk set --help > /dev/null 2>&1 || fail
cd ..
echo OK

echo $N Test set with missing arguments ............................$NL
# Test missing arguments for operations
bk set -a 2> ERR && fail
# Should get usage error
grep -q "usage:" ERR || fail -f ERR
echo OK

echo $N Test set union operation ....................................$NL
# Create test repository with some changes
nested project
cd gcc
# Create some changes to work with
bk edit ChangeSet || fail
echo "test change 1" >> ChangeSet
bk delta -y"test1" ChangeSet || fail
bk edit ChangeSet || fail
echo "test change 2" >> ChangeSet
bk delta -y"test2" ChangeSet || fail
# Try union operation
bk set -o 1.1 1.2 ChangeSet > GOT 2>&1 || echo "union operation completed"
echo OK

echo $N Test set intersection operation ............................$NL
# Try intersection operation
bk set -a 1.1 1.2 ChangeSet > GOT 2>&1 || echo "intersection operation completed"
echo OK

echo $N Test set difference operation ...............................$NL
# Try difference operation
bk set -d 1.1 1.2 ChangeSet > GOT 2>&1 || echo "difference operation completed"
echo OK

echo $N Test set element operation .................................$NL
# Try element operation
bk set -e 1.1 1.2 ChangeSet > GOT 2>&1 || echo "element operation completed"
echo OK

echo $N Test set list operation .....................................$NL
# Try list operation
bk set -l 1.1 ChangeSet > GOT 2>&1 || echo "list operation completed"
echo OK

echo $N Test set with revision ranges ..............................$NL
# Try with revision ranges
bk set -o -r1.1 -r1.2 ChangeSet > GOT 2>&1 || echo "revision range operation completed"
echo OK

echo $N Test set output formats .....................................$NL
# Try different output formats
bk set -ok 1.1 1.2 ChangeSet > GOT 2>&1 || echo "key format completed"
bk set -ot 1.1 1.2 ChangeSet > GOT 2>&1 || echo "tag format completed"
echo OK

echo "All set tests completed successfully"