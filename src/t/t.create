# create -- test create command functionality

echo $N Test create help and usage ...................................$NL
# Test help output
bk create --help > GOT 2>&1
# Should contain usage information
grep -q "usage:" GOT || fail -f GOT
grep -q "create" GOT || fail -f GOT
echo OK

echo $N Test create with invalid options .............................$NL
# Test invalid option
bk create -z 2> ERR && fail
# Should get bad argument error
grep -q "unknown option" ERR || fail -f ERR
echo OK

echo $N Test create command recognition ..............................$NL
# Test that create command is recognized
bk create --help > /dev/null 2>&1 || fail
echo OK

echo $N Test create with missing file argument ......................$NL
# Test missing file argument
bk create 2> ERR && fail
# Should get usage error
grep -q "usage:" ERR || fail -f ERR
echo OK

echo $N Test create basic functionality ...............................$NL
nested project
# Create a new file using create command
echo "test content" > newfile
bk create -y"test create" newfile || fail
# Should create the file successfully
test -f newfile || fail
echo OK

echo $N Test create with comment ......................................$NL
# Create another file with comment
echo "another test" > anotherfile
bk create -y"another test create" anotherfile || fail
test -f anotherfile || fail
echo OK

echo $N Test create in nested component ...............................$NL
cd gcc
# Test create in nested component
echo "component content" > compfile
bk create -y"component create" compfile || fail
test -f compfile || fail
cd ..
echo OK

echo $N Test create with existing file ................................$NL
# Test create on existing file
bk create -y"update" newfile || fail
# Should update the existing file
echo OK

echo "All create tests completed successfully"